# Keep Unix line endings for scripts on every computer (Windows Git would otherwise add \r and the
# scripts would stop with "$'\r': command not found").
* text=auto
*.sh   text eol=lf
*.php  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.py   text eol=lf
*.png  binary
*.jpg  binary
*.webp binary
*.woff2 binary
*.pdf  binary
*.zip  binary
