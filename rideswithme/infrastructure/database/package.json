{
  "name": "@rideswithme/database",
  "version": "0.1.0",
  "private": true,
  "description": "SQL migrations and migration runner",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
