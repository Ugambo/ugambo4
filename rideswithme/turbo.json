{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "TEST_DATABASE_URL",
        "TEST_REDIS_URL",
        "TEST_S3_ENDPOINT",
        "TEST_S3_ACCESS_KEY_ID",
        "TEST_S3_SECRET_ACCESS_KEY",
        "TEST_S3_BUCKET",
        "TEST_S3_SSE"
      ]
    }
  }
}
