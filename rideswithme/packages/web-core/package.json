{
  "name": "@rideswithme/web-core",
  "version": "0.1.0",
  "private": true,
  "description": "Session, token refresh and API proxy for the Next.js apps (server, standard Request/Response), plus shared browser helpers (./client)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "error-tracking-browser.mjs",
    "error-tracking-browser.d.mts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@rideswithme/api-client": "workspace:*",
    "@rideswithme/shared-types": "workspace:*",
    "@rideswithme/utilities": "workspace:*",
    "@rideswithme/validation": "workspace:*",
    "@sentry/nextjs": "11.12.0",
    "jose": "^6.2.17",
    "qrcode": "^1.5.4"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./error-tracking": {
      "types": "./dist/error-tracking.d.ts",
      "default": "./dist/error-tracking.js"
    },
    "./error-tracking-browser": {
      "types": "./error-tracking-browser.d.mts",
      "default": "./error-tracking-browser.mjs"
    },
    "./error-tracking-config": {
      "types": "./dist/error-tracking-config.d.ts",
      "default": "./dist/error-tracking-config.js"
    }
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "react": "19.3.1"
  }
}
