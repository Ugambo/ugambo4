# RideswithMe Driver app. Values starting EXPO_PUBLIC_ are built into the app
# (never put secrets here). Copy to .env for development.

# API base URL as reachable from the phone. On an Android emulator the host
# machine is 10.0.2.2; on a real phone use your computer's LAN IP.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Terms/privacy version shown on the sign-in screen; must match the API's CURRENT_POLICY_VERSION.
EXPO_PUBLIC_POLICY_VERSION=2026-11
