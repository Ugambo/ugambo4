# RideswithMe passenger website (Next.js). Copy to .env.local for development.

# Where the API is, as seen from this server.
API_URL=http://localhost:3000
# Where browsers reach the API for live updates (Socket.IO). Usually the public API address.
API_PUBLIC_URL=http://localhost:3000

# Encrypts the session cookie that holds the passenger's API tokens.
# Base64 of 32 random bytes: openssl rand -base64 32
PASSENGER_SESSION_SECRET=

# Terms/privacy version shown at sign-in; must match the API's CURRENT_POLICY_VERSION.
POLICY_VERSION=2026-11

# Origin serving signed photo links (the driver's photo), for the Content-Security-Policy.
STORAGE_ORIGIN=http://localhost:9000

# Send the session cookie over HTTPS only. Defaults to true when NODE_ENV=production.
# SESSION_COOKIE_SECURE=true
