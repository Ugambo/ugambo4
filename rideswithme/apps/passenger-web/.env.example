# RideswithMe passenger website (Next.js). Copy to .env.local for development.

# Where the API is, as seen from this server.
API_URL=http://localhost:3000
# Where browsers reach the API for live updates (Socket.IO). Usually the public API address.
API_PUBLIC_URL=http://localhost:3000

# Encrypts the session cookie that holds the passenger's API tokens.
# Base64 of 32 random bytes: openssl rand -base64 32
PASSENGER_SESSION_SECRET=

# Terms/privacy version shown at sign-in; must match the API's CURRENT_POLICY_VERSION.
POLICY_VERSION=2026-11

# Origin serving signed photo links (the driver's photo), for the Content-Security-Policy.
STORAGE_ORIGIN=http://localhost:9000

# Street map tiles (Leaflet). The default is OpenStreetMap's free server, which is fine for
# development and light use only: before launch, use a tile provider you have an agreement with
# (see documentation/DECISIONS.md D-081). Leave blank for the default.
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=

# Send the session cookie over HTTPS only. Defaults to true when NODE_ENV=production.
# SESSION_COOKIE_SECURE=true

# Error tracking (Sentry, or a compatible service such as GlitchTip). Off when unset. Used by
# this app's server and, through a tag in the page, by the browser (its address is then added
# to the Content-Security-Policy). Reports never include request data or who it happened to.
# SENTRY_DSN=https://key@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
