{
  "name": "@rideswithme/api",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "start": "node dist/main.js",
    "cli": "node --env-file-if-exists=.env dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "start:local": "node --env-file-if-exists=.env dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/s3-request-presigner": "^3.1167.0",
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@rideswithme/database": "workspace:*",
    "@rideswithme/shared-types": "workspace:*",
    "@rideswithme/utilities": "workspace:*",
    "@rideswithme/validation": "workspace:*",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "kysely": "^0.29.8",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.9",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "unplugin-swc": "^2.0.0"
  }
