# RideswithMe API configuration. Copy to .env and fill in. Every variable is
# validated at startup; the API refuses to start with a clear message if one is wrong.

# --- Runtime ---
# development | test | production
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Number of reverse proxies in front of the API (nginx, load balancer, and the admin
# dashboard server, which calls the API on behalf of admins). Needed for correct
# client IPs in rate limits and audit logs. 0 when the API is exposed directly.
TRUST_PROXY_HOPS=0
# Comma-separated browser origins allowed to call the API (web apps). Empty = none.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# --- Data stores ---
DATABASE_URL=postgres://rideswithme:rideswithme@localhost:5432/rideswithme
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379/0

# --- Access and refresh tokens ---
# At least 32 random characters: openssl rand -hex 32
JWT_ACCESS_SECRET=
# Access token lifetime in seconds (60-3600).
JWT_ACCESS_TTL_SECONDS=900
# A refresh token unused for this many days stops working.
REFRESH_IDLE_TTL_DAYS=30
# A session ends after this many days regardless of use.
REFRESH_ABSOLUTE_TTL_DAYS=90
# Seconds after rotation during which the previous refresh token is still accepted
# once, for clients whose refresh response was lost on a bad connection.
REFRESH_REUSE_GRACE_SECONDS=60

# --- Phone OTP ---
# Secret mixed into stored OTP hashes. At least 32 random characters: openssl rand -hex 32
OTP_PEPPER=
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_PHONE_PER_HOUR=5
OTP_MAX_PER_IP_PER_HOUR=20
OTP_VERIFY_MAX_PER_IP_PER_10_MIN=60

# --- SMS ---
# console (development only: codes are printed in the API log) | termii
SMS_PROVIDER=console
TERMII_API_KEY=
# Registered sender ID, max 11 characters.
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
# dnd reaches numbers on the Do-Not-Disturb register (needed for OTP) | generic
TERMII_CHANNEL=dnd

# --- Field encryption (TOTP secrets now; ID numbers and payout details later) ---
# Comma-separated "<keyId>:<base64 of 32 random bytes>". Generate a key with:
#   echo "k1:$(openssl rand -base64 32)"
# To rotate: add a new key, point FIELD_ENCRYPTION_ACTIVE_KEY_ID at it, keep the old
# key listed until existing values are re-encrypted.
FIELD_ENCRYPTION_KEYS=
FIELD_ENCRYPTION_ACTIVE_KEY_ID=k1

# --- Two-factor authentication (admin, support and fleet roles) ---
# Hours a session stays two-factor verified before asking again.
MFA_SESSION_TTL_HOURS=12
MFA_VERIFY_MAX_PER_15_MIN=5

# --- Privacy (NDPA) ---
# Version of the terms and privacy policy shown at sign-in. Clients send this back
# as consent; bump it when the policy changes so users accept the new version.
CURRENT_POLICY_VERSION=2026-11

# --- Lookups on encrypted values ---
# Keyed hash used to detect duplicates without decrypting (e.g. the same NIN on two
# driver accounts). At least 32 random characters: openssl rand -hex 32.
# Changing it breaks duplicate detection for existing rows.
LOOKUP_HASH_SECRET=

# --- Private object storage (driver documents) ---
# Any S3-compatible service. Leave S3_ENDPOINT empty for AWS S3.
S3_ENDPOINT=http://localhost:9000
# Endpoint written into signed links for phones and browsers, if different from
# S3_ENDPOINT (e.g. the API reaches storage at http://s3:5000 inside Docker).
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
# Private bucket: no public access, no public ACLs.
S3_BUCKET=rideswithme-dev
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=devdevdev
# true for MinIO/moto and most self-hosted services; false for AWS S3.
S3_FORCE_PATH_STYLE=true
# AES256 asks storage to encrypt every document at rest. Required in production.
# none: only for local stores that cannot encrypt.
S3_SERVER_SIDE_ENCRYPTION=AES256
# Create the bucket on startup if missing (development only).
S3_CREATE_BUCKET=true
# How long a signed upload link stays valid, and a signed document-view link.
UPLOAD_URL_TTL_SECONDS=600
DOWNLOAD_URL_TTL_SECONDS=60

# --- Background jobs ---
# Minutes between sweeps that mark expired driver documents (0 turns it off).
# Eligibility checks expiry dates live, so this only keeps stored statuses tidy.
DOCUMENT_EXPIRY_SWEEP_MINUTES=60
