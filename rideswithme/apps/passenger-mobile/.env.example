# RideswithMe passenger app. EXPO_PUBLIC_* values are built into the app; never put secrets here.

# API base URL as reachable from the phone (Android emulator: 10.0.2.2; real phone: your LAN IP).
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
# Must match the API's CURRENT_POLICY_VERSION.
EXPO_PUBLIC_POLICY_VERSION=2026-11

# Google Maps SDK key for Android map tiles (restricted to this app's package and signing key).
# Read at build time by app.config.ts; without it Android shows a blank map. iOS uses Apple Maps.
GOOGLE_MAPS_ANDROID_API_KEY=
