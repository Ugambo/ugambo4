# RideswithMe admin dashboard (Next.js). Copy to .env.local for development.

# Where the API is, as seen from this server (not from the browser).
API_URL=http://localhost:3000

# Encrypts the session cookie that holds the admin's API tokens.
# Base64 of 32 random bytes: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Terms/privacy version shown on the sign-in page; must match the API's CURRENT_POLICY_VERSION.
POLICY_VERSION=2026-11

# Origin of the object storage that serves signed document links (for the
# Content-Security-Policy), e.g. https://rideswithme-docs.s3.eu-west-1.amazonaws.com
# or http://localhost:9000 for local MinIO.
STORAGE_ORIGIN=http://localhost:9000

# Send the session cookie over HTTPS only. Defaults to true when NODE_ENV=production.
# SESSION_COOKIE_SECURE=true
