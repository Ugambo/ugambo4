{
	"version": "2.0.0",
	"options": {
		"shell": { "executable": "bash", "args": [ "-c" ] }
	},
	"windows": {
		"options": {
			"shell": { "executable": "C:\\Program Files\\Git\\bin\\bash.exe", "args": [ "-c" ] }
		}
	},
	"tasks": [
		{
			"label": "Explore Katsina: 1. Set up / update the local site",
			"type": "shell",
			"command": "./setup.sh --offline",
			"problemMatcher": [],
			"presentation": { "reveal": "always", "panel": "dedicated" }
		},
		{
			"label": "Explore Katsina: Start the site",
			"type": "shell",
			"command": "docker compose -f docker-compose.offline.yml up -d && echo 'Site: http://localhost:8888   Test inbox: http://localhost:8025'",
			"problemMatcher": []
		},
		{
			"label": "Explore Katsina: Stop the site",
			"type": "shell",
			"command": "docker compose -f docker-compose.offline.yml stop",
			"problemMatcher": []
		},
		{
			"label": "Explore Katsina: Run all tests",
			"type": "shell",
			"command": "./tests/run.sh",
			"problemMatcher": [],
			"presentation": { "reveal": "always", "panel": "dedicated" }
		},
		{
			"label": "Explore Katsina: Make the small CSS/JS copies (after editing CSS or JS)",
			"type": "shell",
			"command": "npm run build",
			"problemMatcher": []
		},
		{
			"label": "Explore Katsina: Start again from scratch (deletes the local database)",
			"type": "shell",
			"command": "./setup.sh --offline --reset",
			"problemMatcher": [],
			"presentation": { "reveal": "always", "panel": "dedicated" }
		}
	]
}
